<?xml version="1.0" encoding="UTF-8"?>

<!--
    Defines the layout of the dialog window used to add or edit a database connection.
-->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="UI.AddConnectionController"
      styleClass="dialogAdd">

    <Label text="Database connection" styleClass="dialogTitle"/>

    <GridPane fx:id="gridAdd">
        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="LabelAdd"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Host:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="LabelAdd"/>
        <TextField fx:id="hostField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Port:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="LabelAdd"/>
        <TextField fx:id="portField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Database:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="LabelAdd"/>
        <TextField fx:id="dbField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="User:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="LabelAdd"/>
        <TextField fx:id="userField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Password:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="LabelAdd"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox styleClass="dialogButtons">
        <Button text="Save" onAction="#onSave" styleClass="btnSave"/>
        <Button text="Cancel" onAction="#onCancel"/>
    </HBox>
    
</VBox>
