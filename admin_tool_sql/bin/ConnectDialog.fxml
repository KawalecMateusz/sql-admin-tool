<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" 
fx:controller="UI.ConnectDialogController"
xmlns="http://javafx.com/javafx" 
xmlns:fx="http://javafx.com/fxml">
	<Label text="Host"/>
	<TextField fx:id="host"/>
	
	<Label text="DB Name"/>
	<TextField fx:id="db"/>
	
	<Label text="User"/>
	<TextField fx:id="user"/>
	
	<Label text="Password"/>
	<PasswordField fx:id="password"/>
	
	<Button text="Connect" onAction="#onConnect"/>
</VBox>