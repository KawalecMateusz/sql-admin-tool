<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="UI.HistoryController">

    <top>
        <VBox spacing="10" style="-fx-padding:10;">
            <Label text="Query History" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
            <HBox spacing="10">
                <Label text="Database:"/>
                <TextField fx:id="databaseField" prefWidth="150"/>
                <Label text="Type:"/>
                <ComboBox fx:id="typeBox" prefWidth="120"/>
            </HBox>
            <HBox spacing="10">
                <Label text="From:"/>
                <DatePicker fx:id="fromDate"/>
                <Label text="To:"/>
                <DatePicker fx:id="toDate"/>
            </HBox>
            <HBox spacing="10">
                <Button text="Search" onAction="#onFilter"/>
                <Button text="Clear filters" onAction="#onClear"/>
                <Button text="Refresh" onAction="#onRefresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="historyTable">
            <columns>
            	<TableColumn fx:id="nameColumn" text="Connection"/>
                <TableColumn fx:id="databaseColumn" text="Database"/>
                <TableColumn fx:id="typeColumn" text="Type"/>
                <TableColumn fx:id="dateColumn" text="Date"/>
                <TableColumn fx:id="sqlColumn" text="SQL" prefWidth="400"/>
            </columns>
        </TableView>
    </center>

</BorderPane>