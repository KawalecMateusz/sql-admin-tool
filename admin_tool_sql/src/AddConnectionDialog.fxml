<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="UI.AddConnectionController"
      spacing="10"
      style="-fx-padding: 15;">

    <Label text="Add database connection" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Host:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="hostField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Port:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="portField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Database:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="dbField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="User:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="userField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Password:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10">
        <Button text="Save" onAction="#onSave"/>
        <Button text="Cancel" onAction="#onCancel"/>
    </HBox>

</VBox>